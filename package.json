{
  "name": "react-native-plaid-link-sdk",
  "version": "12.8.8",
  "description": "React Native Plaid Link SDK",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "react-native": "src/index.ts",
  "files": [
    "dist/**/*",
    "src/**/*",
    "android/build.gradle",
    "android/gradle.properties",
    "android/gradle/",
    "android/gradlew",
    "android/gradlew.bat",
    "android/src/",
    "ios/*.h",
    "ios/*.m",
    "ios/*.mm",
    "ios/*.swift",
    "ios/Frameworks/",
    "react-native-plaid-link-sdk.podspec",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "check:package": "node scripts/check-package-entrypoints.js",
    "check:linkkit": "node scripts/validate-linkkit-xcframework.js",
    "check:typescript-api": "node scripts/check-typescript-api.js",
    "pack:dry-run": "node scripts/npm-dry-run.js pack",
    "publish:dry-run": "node scripts/npm-dry-run.js publish",
    "lint": "eslint \"*.js\" \"scripts/**/*.js\" --fix",
    "prettier": "prettier \"./**/*.{js,jsx}\" --write",
    "test": "jest"
  },
  "keywords": [
    "react-native",
    "Plaid"
  ],
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "prettier --write",
      "eslint --fix",
      "git add"
    ]
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/__tests__/**"
    ],
    "coverageReporters": [
      "json",
      "json-summary",
      "lcov",
      "text"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/",
      "/example/",
      "/FabricExample/",
      "/exampleReactNative76/"
    ]
  },
  "author": "Plaid",
  "license": "MIT",
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/eslint-parser": "^7.25.1",
    "@react-native-community/eslint-plugin": "^1.1.0",
    "@react-native/babel-preset": "^0.74.3",
    "@types/jest": "^26.0.14",
    "@types/react": "^18.2.6",
    "@types/react-native": "^0.71.3",
    "@types/react-test-renderer": "^16.9.3",
    "@typescript-eslint/eslint-plugin": "^4.33.0",
    "@typescript-eslint/parser": "^4.33.0",
    "babel-eslint": "^10.0.3",
    "eslint": "^7.32.0",
    "eslint-plugin-prettier": "^3.1.4",
    "eslint-plugin-react": "^7.16.0",
    "husky": "^3.1.0",
    "jest": "^29.6.1",
    "lint-staged": "^9.4.2",
    "prettier": "^1.18.2",
    "react": "18.2.0",
    "react-native": "0.84.1",
    "typescript": "^4.9.5"
  },
  "codegenConfig": {
    "name": "rnplaidlink",
    "type": "all",
    "jsSrcsDir": "./src/fabric",
    "android": {
      "javaPackageName": "com.plaid"
    },
    "ios": {
      "modules": {
        "RNLinksdk": {
          "className": "RNLinksdk"
        }
      }
    }
  }
}
